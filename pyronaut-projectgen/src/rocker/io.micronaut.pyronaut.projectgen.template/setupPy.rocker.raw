from wheel.bdist_wheel import bdist_wheel as _bdist_wheel
from setuptools import setup
from setuptools.command.build import build
from pathlib import Path
import subprocess
import shutil
import tomli

# --- Read project metadata ---
pyproject_path = Path(__file__).parent / "pyproject.toml"
with pyproject_path.open("rb") as f:
    pyproject_data = tomli.load(f)

PROJECT_NAME = pyproject_data.get("project", {}).get("name", "myapp")
VERSION = pyproject_data.get("project", {}).get("version", "0.1.0")

class bdist_wheel(_bdist_wheel):
    def finalize_options(self):
        super().finalize_options()
        self.root_is_pure = False

# --- Custom build command ---
class BuildNative(build):
    def run(self):
        self.build_native()
        super().run()

    def build_native(self):
        # --- 1. Build the native binary ---
        native_source = Path("__pyronaut__/native")
        native_source.mkdir(exist_ok=True)
        # subprocess.check_call(["pyronaut", "native"])

        launcher_dir = Path(self.build_lib) / "launcher"
        (launcher_dir / "native").mkdir(parents=True, exist_ok=True)
        shutil.copytree(native_source, launcher_dir / "native", dirs_exist_ok=True)

        # --- 3. Generate launcher inside the package ---
        launcher_path = launcher_dir / "launcher.py"
        launcher_code = f"""\
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).parent
binary = HERE / "native" / "{PROJECT_NAME}"

if not binary.exists():
    sys.exit("Error: binary '{PROJECT_NAME}' not found")

def main():
    subprocess.run([str(binary), *sys.argv[1:]])
"""
        launcher_path.write_text(launcher_code)
        launcher_path.chmod(0o755)



# --- Setup ---
setup(
    name=PROJECT_NAME,
    version=VERSION,
    cmdclass={"build": BuildNative, "bdist_wheel": bdist_wheel},
    packages=["launcher"],
    package_data={
        "launcher": ["native/*"]
    },
    entry_points={
        "console_scripts": [f"{PROJECT_NAME}=launcher.launcher:main"]
    },
)

