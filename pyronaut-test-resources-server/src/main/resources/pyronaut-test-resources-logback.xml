<configuration>
    <property name="PYRONAUT_TEST_RESOURCES_LOGS_DIR" value="${pyronaut.test-resources.logs-dir:-.micronaut/test-resources/logs}"/>
    <property name="PYRONAUT_TEST_RESOURCES_LOG_FILE" value="${PYRONAUT_TEST_RESOURCES_LOGS_DIR}/test-resources.log"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${PYRONAUT_TEST_RESOURCES_LOG_FILE}</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>${PYRONAUT_TEST_RESOURCES_LOGS_DIR}/test-resources.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>5</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <filter class="io.micronaut.pyronaut.testresources.TestResourcesConsoleFilter" />
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <logger name="io.micronaut.testresources.server.TestResourcesController" level="DEBUG" />

    <root level="INFO">
        <appender-ref ref="FILE" />
        <appender-ref ref="STDERR" />
    </root>
</configuration>
