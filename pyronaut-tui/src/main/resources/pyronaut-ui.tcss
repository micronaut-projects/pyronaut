/* Pyronaut TUI Dark Theme (TCSS) */
/* Matches the syntax used in tamboui-css/demos/css-demo/themes/dark.tcss */

$bg-primary: #1d1f21;
$fg-primary: white;
$accent: #8ecae6;
$focus-color: #219ebc;
$highlight: #ffb703;
$dark: #023047;
$warn: #fb8500;
$border-color: gray;
$highlight-bg: #333333;

/* Global defaults */
* {
    color: $fg-primary;
}

.fit {
    width: fit;
}

/* Panels */
Panel {
    background: $bg-primary;
    border-color: $border-color;
    border-type: rounded;
}

Panel:focus {
    border-color: $focus-color;
    border-type: double;
    text-style: bold;
}

Text {
    width: fit;
}

/* Header text */
.header {
    color: $accent;
    text-style: bold;
    border-type: rounded;
    height: 4;
}
.header-title {
    color: $highlight;
    width: fit;
}

/* Footer/status bars (optional utility) */
.status {
    background: #333333;
    color: white;
    border-color: #666666;
    height: 3;
}

.header-row {
    flex: space-between;
    height: 3;
}

.footer-row {
    flex: center;
}

.test-header-row {
    height: 1;
}

.stats-row {
    flex: space-between;
    height: fit;
    text-overflow: ellipsis;
}

.app-status {
    width: fit;
}

.main-row {
    height: fill;
    width: fill;
    flex: start;
}

.tabs {
    width: 20;
}

.tabs TabsElement-tab:selected {
    color: $accent;
    padding: 1;
}

.tabs TabsElement-tab {
    color: #aaaaaa;
    width: fit;
}

.tabs TabsElement-divider {
    text-style: dim;
    color: grey;
}

.tests {
    height: fill;
}

.activity {
    height: fill;
}

.test-header-row {
    height: 1;
}

/* Two-panel tests row */
#tests {
    height: fill;
}

.header-row {
    height: 2;
}

.footer-row {
    height: 1;
}

.test-header-row {
    height: 1;
}

.updated-files {
    flex: start;
    text-overflow: wrap-character;
    width: fit;
}

/* Chips (state indicators) */
.chip {
    text-style: bold;
    /* border rendering is widget-driven; color cues via classes below */
}

.state-running {
    color: #aaffaa;
}

.state-compiling {
    color: #ffffaf;
}

.state-testing {
    color: #e0ffff;
}

.state-idle {
    color: dark-gray;
    text-style: dim;
}

/* Severity helpers */
.info {
    color: light-$accent;
}

.warning {
    color: light-yellow;
}

.error {
    color: light-red;
    text-style: bold;
}

.success {
    color: light-green;
}

/* Generic helpers */
.primary {
    color: $accent;
    text-style: bold;
}

.secondary {
    color: dark-gray;
}

.dim {
    text-style: dim;
}

.footer {
    border-type: none;
}

.activity {
    width: fill;
    height: fill;
}

.log-item {
    text-overflow: wrap-character;
}

.code {
    color: $accent;
    text-style: italic dim;
}

.endpoints * {
    text-overflow: wrap-word;
}

.notifications * {
    text-overflow: wrap-word;
}
