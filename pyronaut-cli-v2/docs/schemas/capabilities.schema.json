{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyronaut.io/schemas/cli-v2/capabilities.schema.json",
  "title": "Pyronaut CLI v2 Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "commandName",
    "commandVersion",
    "supportedCommands",
    "features"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "commandName": {
      "type": "string"
    },
    "commandVersion": {
      "type": "string"
    },
    "supportedCommands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "install",
          "process",
          "run",
          "test",
          "build",
          "validate-config",
          "test-resources-server",
          "tui",
          "native-build"
        ]
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jsonOutput",
        "offlineMode",
        "dryRun",
        "platforms"
      ],
      "properties": {
        "jsonOutput": {
          "type": "boolean"
        },
        "offlineMode": {
          "type": "boolean"
        },
        "dryRun": {
          "type": "boolean"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "debugVm": {
          "type": "boolean"
        },
        "testSelectors": {
          "type": "boolean"
        },
        "nativeBuild": {
          "type": "boolean"
        },
        "nativeImageArgPassthrough": {
          "type": "boolean"
        },
        "validateConfig": {
          "type": "boolean"
        },
        "testResourcesServer": {
          "type": "boolean"
        },
        "tuiDelegation": {
          "type": "boolean"
        }
      }
    }
  }
}
