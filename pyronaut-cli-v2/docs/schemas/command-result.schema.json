{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyronaut.io/schemas/cli-v2/command-result.schema.json",
  "title": "Pyronaut CLI v2 Command Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "command",
    "status",
    "exitCode",
    "durationMs",
    "artifacts"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "command": {
      "type": "string",
      "enum": [
        "install",
        "process",
        "run",
        "test",
        "build",
        "tui",
        "native-build"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "error"
      ]
    },
    "exitCode": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "code",
        "category",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ]
}
