<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.FileAppender">
        <file>build/tui-app.log</file>
        <append>true</append>
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>

    <root level="error">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
